cmake_minimum_required(VERSION 3.25)

file(READ "${CMAKE_CURRENT_LIST_DIR}/../CMakePresets.json" presets_json)

function(find_preset array_name wanted_name output_index)
  string(JSON preset_count LENGTH "${presets_json}" "${array_name}")
  math(EXPR last_index "${preset_count} - 1")
  foreach(index RANGE 0 ${last_index})
    string(JSON current_name GET "${presets_json}" "${array_name}" ${index} name)
    if(current_name STREQUAL wanted_name)
      set(${output_index} ${index} PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Missing ${array_name} preset: ${wanted_name}")
endfunction()

find_preset(configurePresets base base_index)
string(JSON generator_error ERROR_VARIABLE generator_error GET
       "${presets_json}" configurePresets ${base_index} generator)
if(generator_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "base preset must not set generator")
else()
  message(STATUS "base preset does not fix a platform-specific generator")
endif()

foreach(array_name IN ITEMS buildPresets testPresets)
  foreach(entry IN ITEMS debug release)
    find_preset(${array_name} ${entry} entry_index)
    string(JSON configuration GET "${presets_json}" ${array_name} ${entry_index}
           configuration)
    if(entry STREQUAL "debug" AND NOT configuration STREQUAL "Debug")
      message(FATAL_ERROR "${array_name} debug must select Debug")
    endif()
    if(entry STREQUAL "release" AND NOT configuration STREQUAL "Release")
      message(FATAL_ERROR "${array_name} release must select Release")
    endif()
  endforeach()
endforeach()
